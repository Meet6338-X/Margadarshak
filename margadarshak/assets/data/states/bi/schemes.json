    {
      "id": "bihar_7nishchay_yuva",
      "kind": "scheme",
      "title": {
        "en": "7 Nishchay Yuva Mission",
        "hi": "7 निश्चय युवा मिशन",
        "mr": "७ निश्चय युवा मिशन"
      },
      "summary": {
        "en": "Bihar mission providing free training and placement support for unemployed youth across the state.",
        "hi": "बिहार मिशन जो बेरोजगार युवाओं को राज्य भर में मुफ्त प्रशिक्षण और नौकरी सहायता देता है।",
        "mr": "बिहार मिशन जे राज्यभरातील बेरोजगार तरुणांना मोफत प्रशिक्षण आणि नोकरी सहाय्य देतो."
      },
      "officialSourceName": "7 Nishchay Yuva Mission, Bihar",
      "officialSourceUrl": "https://www.7nishchay-yuvaupmission.bihar.gov.in/",
      "lastVerifiedAt": "2026-10-22",
      "applyUrl": "https://www.7nishchay-yuvaupmission.bihar.gov.in/howToApply",
      "applySteps": [
        {
          "en": "Register online on the MNSSBY portal with your Aadhaar number.",
          "hi": "आधार नंबर से MNSSBY पोर्टल पर ऑनलाइन पंजीकरण करें।",
          "mr": "आधार क्रमांकाने MNSSBY पोर्टलवर ऑनलाइन नोंदणी करा."
        },
        {
          "en": "Visit your District Registration and Counselling Centre (DRCC) with your documents within 60 days, between 10 am and 5 pm on working days.",
          "hi": "कार्य दिवसों पर सुबह 10 से शाम 5 बजे के बीच, 60 दिनों के भीतर ज़रूरी दस्तावेज़ों के साथ अपने ज़िले के DRCC कार्यालय जाएँ।",
          "mr": "कामकाजी दिवशी सकाळी 10 ते संध्याकाळी 5 या वेळेत, 60 दिवसांत आवश्यक कागजपत्रांसह तुमच्या जिल्ह्याच्या DRCC कार्यालयात जा."
        },
        {
          "en": "Get your bank account linked to your Aadhaar so the benefit can reach your account.",
          "hi": "बैंक खाते को आधार से सीडिंग करवाएँ, ताकि राशि आपके खाते तक पहुँच सके।",
          "mr": "बँक खाते आधारशी सीडिंग करा, म्हणजे रक्कम तुमच्या खात्यात पोहोचेल."
        }
      ],
